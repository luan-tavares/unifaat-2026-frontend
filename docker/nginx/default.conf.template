# Servidores WebSocket (réplicas): o nginx distribui as CONEXÕES entre eles. O Docker devolve o IP de cada
# réplica de nodewebsocket_host; o nginx resolve o nome na subida (réplica nova: nginx -s reload).
upstream websocket_servers {
    # ip_hash;  # sticky: só é preciso se o client usar polling; em sala de aula todos saem pelo mesmo IP
    server nodewebsocket_host:3001;
}

server {
    
    listen ${NGINX_PORT}; # Porta em que o NGINX vai escutar, vem do .env

    root /var/www/; # Diretório raiz dos arquivos estáticos, inseridos do coker compose
    index index.html; # Arquivo padrão a ser carregado, nos arquivos estáticos

    client_max_body_size 100M; # Tamanho máximo permitido do corpo da requisição

    # /metrics é do Prometheus: de fora (pelo nginx) devolve 404; o Prometheus coleta direto no nodeweb, pela data-network
    location = /metrics {
        return 404;
    }

    # /stub_status também é interno: de fora (pelo nginx na porta publicada) devolve 404; o exporter lê pela porta 8081 abaixo
    location = /stub_status {
        return 404;
    }

    location / {
        autoindex on; # Mostra índice de arquivos se não encontrar o index
        try_files $uri.html $uri $uri/ @node; # Procura o arquivo estático => procura o diretório estático => senao vai para o bloco @node
    }

    # WebSocket (Socket.IO): repassa o Upgrade, a conexão fica aberta e o nginx escolhe a réplica na abertura do túnel
    location /socket.io/ {
        proxy_pass http://websocket_servers; # Container(s) do websocket, pela rede interna
        proxy_http_version 1.1; # O Upgrade só existe no HTTP/1.1
        proxy_set_header Upgrade $http_upgrade; # Pede a troca de protocolo para websocket
        proxy_set_header Connection "upgrade"; # Mantém a conexão aberta para a troca
        proxy_set_header Host $host; # Passa pra frente o host/nome do domínio
        proxy_set_header X-Real-IP $remote_addr; # IP de origem: o chat mostra quem está online
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; # Encadeia os IPs no cabeçalho
        proxy_read_timeout 1h; # Túnel parado não é derrubado em 60 s
    }

    location @node {

        proxy_pass http://nodeweb_host:3000; # "Passa" para o container Node na porta 3000 pelo protocolo HTTP
        proxy_http_version 1.1; # Usa versão 1.1 do HTTP para manter conexões persistentes
        proxy_set_header Host $host; # Passa pra frente o host/nome do domínio
        proxy_set_header X-Real-IP $remote_addr; # Passa pra frente o IP de origem
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; # Encadeia os IPs no cabeçalho para rastrear origem real
        proxy_set_header X-Forwarded-Proto $scheme; # Passa pra frente se é HTTP ou HTTPS

    }

}

# Porta interna do nginx: não é publicada no docker-compose, só quem está na edge-network (o exporter do Prometheus) chega aqui
server {

    listen 8081;

    location = /stub_status {
        stub_status; # Conexões ativas e total de requisições que o nginx atendeu (inclusive arquivos estáticos)
    }

}
